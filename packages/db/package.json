{
  "name": "@sitepilot/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "bun run src/migrate.ts",
    "seed": "bun run src/seed.ts",
    "push": "drizzle-kit push",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "migrate:sqlite": "bun run src/sqlite/migrate.ts",
    "seed:sqlite": "DB_DRIVER=sqlite DATABASE_URL=file:./dev.db bun run src/seed.ts",
    "generate:sqlite": "bunx drizzle-kit generate --config=drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "@sitepilot/shared": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  }
}